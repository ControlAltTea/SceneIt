generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Users now use username as the primary ID
model User {
  username  String      @id
  email     String      @unique
  password  String
  playlists Playlist[]
  watchlist Watchlist[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  comment   Comment[]
  rating    Rating[]
}

/// Unified model for both Movies and TV Shows
model Media {
  tmdbId        Int             @id
  title         String
  type          MediaType       @default(MOVIE)
  genres        Genre[]
  description   String?
  posterUrl     String?
  producer      String?
  releaseYear   Int?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now()) @updatedAt
  episodes      Episode[]
  playlistMedia PlaylistMedia[]
  rating        Rating[]
  watchlist     Watchlist[]
  comment       Comment[]
}

/// Episodes reference a Media item by TMDB ID (only used for TV series)
model Episode {
  mediaTmdbId   Int
  seasonNumber  Int
  episodeNumber Int
  name          String
  airDate       DateTime?
  createdAt     DateTime  @default(now())

  media Media @relation(fields: [mediaTmdbId], references: [tmdbId], onDelete: Cascade)

  @@id([mediaTmdbId, seasonNumber, episodeNumber])
}

/// Each watchlist entry links one user ↔ one media item
model Watchlist {
  userUsername String
  mediaTmdbId  Int
  status       WatchStatus @default(PLANNED)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @default(now()) @updatedAt

  user  User  @relation(fields: [userUsername], references: [username], onDelete: Cascade)
  media Media @relation(fields: [mediaTmdbId], references: [tmdbId], onDelete: Cascade)

  @@id([userUsername, mediaTmdbId])
}

/// Playlist belongs to a single user
model Playlist {
  id            Int             @id @default(autoincrement())
  ownerUsername String
  name          String
  isPublic      Boolean         @default(true)
  isFavorite    Boolean         @default(false)
  playlistMedia PlaylistMedia[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now()) @updatedAt

  owner   User      @relation(fields: [ownerUsername], references: [username], onDelete: Cascade)
  comment Comment[]
  rating  Rating[]

  @@unique([name, ownerUsername]) // keep this unique to prevent duplicates
}

/// PlaylistMedia connects playlists with TV series and Movies
model PlaylistMedia {
  playlistName  String
  ownerUsername String
  mediaTmdbId   Int
  playlist      Playlist @relation(fields: [playlistName, ownerUsername], references: [name, ownerUsername], onDelete: Cascade)
  media         Media    @relation(fields: [mediaTmdbId], references: [tmdbId], onDelete: Cascade)

  @@id([playlistName, ownerUsername, mediaTmdbId])
}

/// Comments can belong to either a Media item or a Playlist
model Comment {
  id           Int      @id @default(autoincrement())
  content      String
  userUsername String
  mediaTmdbId  Int? // optional if comment is on a playlist
  playlistId   Int? // optional if comment is on a playlist
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  user     User      @relation(fields: [userUsername], references: [username], onDelete: Cascade)
  media    Media?    @relation(fields: [mediaTmdbId], references: [tmdbId], onDelete: Cascade)
  playlist Playlist? @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@index([mediaTmdbId])
  @@index([playlistId])
}

/// Ratings can be attached to movie/tv-shows or a playlist created by a user
model Rating {
  id           Int      @id @default(autoincrement())
  rating       Int
  userUsername String
  mediaTmdbId  Int?
  playlistId   Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User      @relation(fields: [userUsername], references: [username])
  playlist Playlist? @relation(fields: [playlistId], references: [id])
  media    Media?    @relation(fields: [mediaTmdbId], references: [tmdbId])

  @@unique([userUsername, mediaTmdbId])
  @@unique([userUsername, playlistId])
  @@index([mediaTmdbId])
  @@index([playlistId])
}

/// Enums
enum MediaType {
  MOVIE
  TV
}

enum WatchStatus {
  WATCHING
  COMPLETED
  PLANNED
  DROPPED
  REMOVED
}

enum Genre {
  ACTION
  COMEDY
  DRAMA
  FANTASY
  HORROR
  ROMANCE
  SCIFI
  THRILLER
  ANIMATION
}
