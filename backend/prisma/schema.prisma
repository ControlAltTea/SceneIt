generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  username  String      @id
  email     String      @unique
  password  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  Comment   Comment[]
  Playlist  Playlist[]
  Rating    Rating[]
  Watchlist Watchlist[]
}

model Episode {
  mediaTmdbId   Int
  seasonNumber  Int
  episodeNumber Int
  name          String
  airDate       DateTime?
  createdAt     DateTime  @default(now())
  Media         Media     @relation(fields: [mediaTmdbId], references: [tmdbId], onDelete: Cascade)

  @@id([mediaTmdbId, seasonNumber, episodeNumber])
}

model Rating {
  userUsername String
  mediaTmdbId  Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
  id           Int       @id @default(autoincrement())
  playlistId   Int?
  rating       Int
  Media        Media?    @relation(fields: [mediaTmdbId], references: [tmdbId])
  Playlist     Playlist? @relation(fields: [playlistId], references: [id])
  User         User      @relation(fields: [userUsername], references: [username])

  @@unique([userUsername, mediaTmdbId])
  @@unique([userUsername, playlistId])
  @@index([mediaTmdbId])
  @@index([playlistId])
}

model Watchlist {
  userUsername String
  mediaTmdbId  Int
  status       WatchStatus @default(PLANNED)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @default(now())
  Media        Media       @relation(fields: [mediaTmdbId], references: [tmdbId], onDelete: Cascade)
  User         User        @relation(fields: [userUsername], references: [username], onDelete: Cascade)

  @@id([userUsername, mediaTmdbId])
}

model Playlist {
  id            Int             @id @default(autoincrement())
  ownerUsername String
  name          String
  isPublic      Boolean         @default(true)
  isFavorite    Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now()) @updatedAt
  Comment       Comment[]
  User          User            @relation(fields: [ownerUsername], references: [username], onDelete: Cascade)
  PlaylistMedia PlaylistMedia[]
  Rating        Rating[]

  @@unique([name, ownerUsername])
}

model Comment {
  id           Int       @id @default(autoincrement())
  content      String
  userUsername String
  mediaTmdbId  Int?
  playlistId   Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now())
  Media        Media?    @relation(fields: [mediaTmdbId], references: [tmdbId], onDelete: Cascade)
  Playlist     Playlist? @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  User         User      @relation(fields: [userUsername], references: [username], onDelete: Cascade)

  @@index([mediaTmdbId])
  @@index([playlistId])
}

model Media {
  tmdbId        Int             @id
  title         String
  type          MediaType       @default(MOVIE)
  genres        Genre[]
  description   String?
  posterUrl     String?
  producer      String?
  releaseYear   Int?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now())
  Comment       Comment[]
  Episode       Episode[]
  PlaylistMedia PlaylistMedia[]
  Rating        Rating[]
  Watchlist     Watchlist[]
}

model PlaylistMedia {
  playlistName  String
  ownerUsername String
  mediaTmdbId   Int
  Media         Media    @relation(fields: [mediaTmdbId], references: [tmdbId], onDelete: Cascade)
  Playlist      Playlist @relation(fields: [playlistName, ownerUsername], references: [name, ownerUsername], onDelete: Cascade)

  @@id([playlistName, ownerUsername, mediaTmdbId])
}

enum WatchStatus {
  WATCHING
  COMPLETED
  PLANNED
  DROPPED
  REMOVED
}

enum Genre {
  ACTION
  COMEDY
  DRAMA
  FANTASY
  HORROR
  ROMANCE
  SCIFI
  THRILLER
  ANIMATION
}

enum MediaType {
  MOVIE
  TV
}
