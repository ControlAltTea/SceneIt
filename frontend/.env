# --- Frontend Environment Variables (Vite) ---

# The backend API URL (Express/Prisma)
VITE_API_URL=http://localhost:8080

# TMDB API Key (replace with your real one)
# You can get it from https://developer.themoviedb.org/
VITE_TMDB_API_KEY=YOUR_TMDB_API_KEY_HERE

# (Optional) Set a default pagination size for consistency
VITE_PAGE_SIZE=20
