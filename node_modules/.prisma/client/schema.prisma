generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (pgbouncer) URL
  directUrl = env("DIRECT_URL") // direct port 5432 for migrations
}

enum Genre {
  ACTION
  ANIMATION
  COMEDY
  DRAMA
  FANTASY
  HORROR
  ROMANCE
  SCIFI
  THRILLER
}

enum MediaType {
  MOVIE
  TV
}

enum WatchStatus {
  watching
  completed
  planned
  dropped
  removed
}

model User {
  username  String      @id
  email     String      @unique
  playlists Playlist[]
  ratings   Rating[]
  watchlist Watchlist[]
}

model Media {
  tmdbId      Int       @id
  title       String
  description String?
  releaseYear Int?
  genres      Genre[]
  type        MediaType
  updatedAt   DateTime  @updatedAt

  PlaylistMedia PlaylistMedia[]
  Rating        Rating[]
  Watchlist     Watchlist[]
}

model Playlist {
  name          String
  ownerUsername String
  isPublic      Boolean @default(false)

  owner User            @relation(fields: [ownerUsername], references: [username])
  shows PlaylistMedia[]

  @@id([name, ownerUsername])
}

model PlaylistMedia {
  playlistName  String
  ownerUsername String
  mediaTmdbId   Int

  playlist Playlist @relation(fields: [playlistName, ownerUsername], references: [name, ownerUsername])
  media    Media    @relation(fields: [mediaTmdbId], references: [tmdbId])

  @@id([playlistName, ownerUsername, mediaTmdbId])
}

model Rating {
  userUsername String
  mediaTmdbId  Int
  score        Int
  review       String?
  updatedAt    DateTime @updatedAt

  user  User  @relation(fields: [userUsername], references: [username])
  media Media @relation(fields: [mediaTmdbId], references: [tmdbId])

  @@id([userUsername, mediaTmdbId])
}

model Watchlist {
  userUsername String
  mediaTmdbId  Int
  status       WatchStatus
  updatedAt    DateTime    @updatedAt

  user  User  @relation(fields: [userUsername], references: [username])
  media Media @relation(fields: [mediaTmdbId], references: [tmdbId])

  @@id([userUsername, mediaTmdbId])
}
